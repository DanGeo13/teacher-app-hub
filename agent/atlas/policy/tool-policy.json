        "memory",
        "cronjob"
      ],
      "api_server": [
        "memory",
        "cronjob"
      ],
      "cron": [
        "memory"
      ]
    },
    "allowedMcpServers": [
      "atlas-hub",
      "gmail_personal",
      "gmail_work"
    ],
    "forbiddenToolsets": [
      "terminal",
      "process",
      "file",
      "browser",
