# Copy to .env for local development only. Never commit the real file.
# Use a unique password of at least 16 characters.
HUB_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Replace with a writable absolute path outside the tracked repository.
HUB_DATA_DIR=/absolute/path/outside/repository/hermes-hub-data

# Keep true for HTTPS. An explicit false override is only for loopback HTTP development.
HUB_COOKIE_SECURE=true
# Required: one or more exact browser origins, comma-separated. Forwarded headers are ignored.
HUB_ALLOWED_ORIGINS=https://replace-with-your-private-hub-origin.example
HUB_SESSION_TTL_SECONDS=43200

# Runtime probes are server-side and default to loopback endpoints.
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
HERMES_EXECUTABLE=hermes
OLLAMA_BASE_URL=http://127.0.0.1:11434
HUB_RUNTIME_PROBE_TIMEOUT_SECONDS=2

# Hermes ACP sessions (docs/hermes-sessions.md). Point HERMES_EXECUTABLE at the
# installed binary (an absolute path when Hermes lives in a virtual environment).
# The model provider is configured in Hermes itself (hermes model / hermes setup
# or a custom_providers entry); without it sessions honestly fail with 503.
# HUB_HERMES_WORKSPACE_DIR=/absolute/path/hermes-workspace
# HUB_HERMES_STARTUP_TIMEOUT_SECONDS=30
# HUB_HERMES_TURN_TIMEOUT_SECONDS=900

# Optional path to an already-built frontend.
# HUB_FRONTEND_DIST=/absolute/path/to/Apps/system/hermes-hub/frontend/dist
